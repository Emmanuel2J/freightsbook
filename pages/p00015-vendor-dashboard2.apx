page 15 (
    name: Vendor Dashboard
    alias: VENDOR-DASHBOARD2
    title: Vendor Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #dash-tabs .t-Tabs-link:focus {
                outline: none;
                outline-offset: none;
            }
            
            
            
            .main-heading .t-HeroRegion-title{
                font-size: 1.6rem !important;
                    line-height: 1.3;
            }
            
            .subtitle{
                font-size: 0.9rem !important;
            
            
            }
            
            #add-rate > span.t-Icon.t-Icon--right.fa.fa-plus-square{
                display: none;
            }
            
            .fb-viewall {
              border: 0;
              background: none;
              cursor: pointer;
              padding: 0;
              font-size: 14px;
              font-weight: 600;
              color: #00688c;
              white-space: nowrap;
            }
            .fb-viewall:hover { text-decoration: underline; }
            
            .fb-search-list {
              list-style: none;
              margin: 16px 0 0;
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: 8px;
            }
            
            .fb-search-row {
              border: 1px solid rgba(226, 230, 234, .6);
              background: #f4f7f9;
              border-radius: 8px;
              padding: 12px 16px;
            }
            
            .fb-search-lane {
              margin: 0;
              font-size: 14px;
              font-weight: 600;
              color: #1a2530;
            }
            .fb-search-lane span { color: #6b7785; }
            
            .fb-search-meta {
              margin: 4px 0 0;
              font-size: 12px;
              color: #6b7785;
            }
            .fb-sep { margin: 0 6px; color: #d3d9de; }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region approvals (
        name: Approvals
