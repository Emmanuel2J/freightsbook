    region rate-searches (
        name: Top Rate Searches
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ORIGIN_PORT_ID,
                       ORIGIN_PORT_NAME,
                       DESTINATION_PORT_ID,
                       DESTINATION_PORT_NAME,
                       SEARCH_COUNT,
                       ROUTE_LABEL
                  from V_MOST_SEARCHED_ROUTES
                  order by SEARCH_COUNT desc
                  FETCH FIRST 5 ROWS ONLY;
                ```
        }
        layout {
            sequence: 40
            parentRegion: @overview
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
