        }
    )

    region metrics (
        name: Metrics
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Active Rates' as label, ACTIVE_NOW,ACTIVE_30_DAYS_AGO, TREND_PCT || '%'  as TREND_PCT,
                'fa-ship' as icon,
                
                case when ACTIVE_NOW > ACTIVE_30_DAYS_AGO then 'fa-trend-up'
                     when ACTIVE_NOW < ACTIVE_30_DAYS_AGO then 'fa-trend-down'
                     else '' end as TREND_ICON,
                case when ACTIVE_NOW > ACTIVE_30_DAYS_AGO then 'success'
                     when ACTIVE_NOW < ACTIVE_30_DAYS_AGO then 'danger'
                     else 'info' end as trend_state
                        
                FROM V_ACTIVE_RATES
                where vendor_id = :A_VENDOR_ID
                
                union all
                
                select 'Rates Expiring in 2 Days' as label, expiring_within_2_days, null, null, 'fa-warning' as icon, null, null
                from V_RATE_EXPIRING_SOON where vendor_id = :A_VENDOR_ID
                
                union all
                
                select 'Enquires (30d)' as label, enquiries_last_30_days, enquiries_prior_30_days,
                trend_pct || '%' as trend_pct, 'fa-bell' as icon,
                case when enquiries_last_30_days > enquiries_prior_30_days then 'fa-trend-up'
                     when enquiries_last_30_days < enquiries_prior_30_days then 'fa-trend-down'
                     else '' end as TREND_ICON,
                case when enquiries_last_30_days > enquiries_prior_30_days then 'success'
                     when enquiries_last_30_days < enquiries_prior_30_days then 'danger'
                     else 'info' end as TREND_state
                
                from V_VENDOR_ENQUIRY_TREND where vendor_id = :A_VENDOR_ID
                
                union all
                select 'Rate Views (30d)' as label, views_last_30_days, views_prior_30_days,
                trend_pct || '%' as trend_pct, 'fa-eye' as icon,
                case when views_last_30_days > views_prior_30_days then 'fa-trend-up'
                     when views_last_30_days < views_prior_30_days then 'fa-trend-down'
                     else '' end as TREND_ICON,
                case when views_last_30_days > views_prior_30_days then 'success'
                     when views_last_30_days < views_prior_30_days then 'danger'
                     else 'info' end as TREND_state
                
                from V_RATE_VIEWS_COUNT where vendor_id = :A_VENDOR_ID
                ```
        }
        layout {
            sequence: 10
            parentRegion: @overview
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &ACTIVE_NOW.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: 4Columns
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }
        plugin-badge {
            displayBadge: true
            label: Trend
            value: TREND_PCT
            state: TREND_STATE
            icon: &TREND_ICON.
            style: subtle
            shape: rounded
        }

