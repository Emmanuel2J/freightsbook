    region recent-searhes (
        name: Recent Searhes
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select R.PK_ID,
                       apex_util.get_since(R.SEARCH_TIME) AS SEARCH_TIME_AGO,
                       R.SEARCH_TIME,
                       R.ORIGIN_PORT_ID,
                       R.DESTINATION_PORT_ID,
                       R.SEARCH_TYPE,
                       
                       CASE WHEN R.SEARCH_TYPE = 'FCL' THEN to_char(C.CONT_TYPE)
                       ELSE to_char(CBM) || ' CBM &middot; ' || to_char(WEIGHT) || ' kg' end as search_dets,
                       case when SEARCH_TYPE = 'FCL' then '&middot; Qty ' || QTY
                       else '' end as qty,
                       R.DIM_UNIT,
                       R.WEI_UNIT,
                       R.ITEM_LENGTH,
                       R.ITEM_WIDTH,
                       R.ITEM_HEIGHT,
                       R.CBM,
                       R.WEIGHT
                  from RATE_SEARCH_LOG R
                  LEFT JOIN CONTAINER_MST C ON R.CONT_TYPE = C.PK_ID
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: R.SEARCH_TIME
        }
        layout {
            sequence: 50
            parentRegion: @overview
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h240
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            display: report
        }
        settings {
            title: <p class="fb-search-lane">Quilon <span>&rarr;</span> Rotterdam</p>
            miscellaneous:
                ```html
                      <p class="fb-search-meta">&SEARCH_TYPE. &middot; &SEARCH_DETS!RAW. &QTY!RAW. <span class="fb-sep">|</span> &SEARCH_TIME_AGO.</p>
                
                ```
        }
        plugin-appearance {
            style: compact
        }

