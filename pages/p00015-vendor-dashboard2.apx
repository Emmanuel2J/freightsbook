        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 10
                    items: {
                        P10_PK_ID: &DOC_REQ_ID.
                    }
                }
            }
        )

        action approve (
            position: primaryActions
            template: button
            label: Approve
            layout {
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-check-square u-success-text
                cssClasses: approve
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :TASK_TYPE = 'APPROVAL' and :STATE_CODE != 'INFO_REQUESTED'
            }
        )

        action claim (
            position: primaryActions
            template: button
            label: Claim
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-user-plus u-hot-text
                cssClasses: claim
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :STATE_CODE = 'UNASSIGNED'
            }
        )

        action reject (
            position: primaryActions
            template: button
            label: Reject
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-times u-danger-text
                cssClasses: reject
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :TASK_TYPE = 'APPROVAL' and :STATE_CODE != 'INFO_REQUESTED'
            }
        )

    )

    region new (
        name: Rates
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RATE_PK_ID,
                       VENDOR_ID,
                       RATE_REF_NO,
                       RATE_FROM_COUN,
                       FROM_COUN_NAME,
                       RATE_FROM_PORT,
                       FROM_PORT_NAME,
                       FROM_PORT_CODE,
                       RATE_TO_COUN,
                       TO_COUN_NAME,
                       RATE_TO_PORT,
                       TO_PORT_NAME,
                       TO_PORT_CODE,
                       FCL_LCL_FLAG,
                       FCL_CONTAINER_TYPE,
                       CONT_TYPE_NAME,
                       RATE,
                       FCL_RATE,
                       LCL_RATE,
                       TRANSIT_TIME,
                       VALID_FROM,
                       VALID_TO,
                       CUSER,
                       CDATE,
                       UUSER,
                       UDATE
                  from V_RATE_MST
                 where VENDOR_ID =:A_VENDOR_ID OR :APP_USER = 'ADMIN'
                ```
        }
        layout {
            sequence: 20
            parentRegion: @manage-rates
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
