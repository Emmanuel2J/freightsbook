                    $("#P1_CBM").attr('readonly','readonly');
                    $("#P1_CBM").addClass('apex_disabled');
                    
                    $("#P1_TOTAL_WEIGHT").attr('readonly','readonly');
                    $("#P1_TOTAL_WEIGHT").addClass('apex_disabled');
                    
                    
                    
                    
