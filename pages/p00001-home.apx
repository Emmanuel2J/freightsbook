page 1 (
    name: Home
    alias: HOME
    title: FreightsBook
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-Body-contentInner{
                padding: 0;
                
            }
            
            #main-hero{
                height: fit-content;
                margin: 0;
                background-color: #00698c88;
                border-radius: 0;
            }
            
            .hero-r{
                display: flex;
                flex-direction: column;
                align-items: center;
                padding-top: 4rem;
                height:max-content;
                font-family: "Roboto", sans-serif;
            }
            
            .hero-title{
                font-size:4.0rem;
                font-weight: 600;
                text-align: center;
                text-wrap:balance;
                line-height:1;
                margin-inline: auto;
                color:white;
                padding-bottom:1rem;
                width:50%;
            
            } 
            
            .hero-sub-title{
                font-size:1.125rem;
                font-weight: 1;
                text-align: center;
                text-wrap:balance;
                line-height:1;
                width: 50%;
                color:rgba(255, 255, 255, 0.85);
                font-family: sans-serif;
                margin-top:0.5rem;
                margin-inline:auto;
            }   
            
            #search-area{
                margin:2.5rem;
            }
            
            .hero-image{
                object-fit:cover;
                top:0 !important;
                width: 100%;
                height: 100%;
                z-index:-10;
                inset:0;
                position: absolute;
                max-width: 100%;
                display: block;
                overflow-clip-margin: content-box;
                overflow: clip;
            }
            
            #search-area{
                padding: 0.5rem 1rem 1rem 1rem; /* top right bottom left */
                border-radius: 1.125rem;
            }
            
            #P1_RATE_TYPE{
                margin-top: 0;
            }
            #P1_RATE_TYPE label{
                padding: 0.5rem;
            }
            #P1_RATE_TYPE label > span{
                    font-size: 0.8rem;
            }
            .apex-item-group--rc input:checked+label, .apex-item-single-checkbox input:checked+label {
                background-color: var(--ut-header-background-color);
                outline: none !important;
                border:none !important;
                font-weight: 500!important;
            }
            
            #P1_RATE_TYPE > div > div{
                display:grid !important;
                grid-template-columns: 1fr 1fr !important;
            }
            
            .t-Button--gapTop{
                margin-top: 1.9rem !important;
            }
            
            .search-footer{
                color: rgba(0, 0, 0, 0.696);
                font-size: 0.75rem;
            }
            .metric-cards{
                background-color: transparent;
                border:0;
            }
            .metric-cards .a-CardView-title {
                color:white;
                font-size: 2.5rem;
            }
            .metric-cards .a-CardView-subTitle  {
                color:white;
                font-weight: 100;
                font-size:0.8rem;
                margin-top:0.9rem;
            }
            
            #P1_ORIGIN_PORT_LABEL::before{
                display: none;
            }
            #P1_DESTINATION_PORT_LABEL::before{
                display: none;
            }
            
            .a-Form-error{
                display: none !important;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap');
            </style>
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fcl-items (
        name: FCL Items
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @parent
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
    )

    region hero-region (
        name: Hero Region
        type: staticContent
        source {
            htmlCode:
                ```html
                <img src="#APP_FILES#hero-ocean-freight.png" class = "hero-image">
                <div class = 'hero-r'>
                    <div class = 'hero-title'>Find the cheapest ocean freight rate in seconds</div>
                    <div class = 'hero-sub-title'>Compare freight rates from trusted FCL & LCL vendors, all in one place.</div>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: main-hero
        }
    )

    region lcl-items (
        name: LCL Items
        type: staticContent
        layout {
            sequence: 100
            parentRegion: @parent
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
        advanced {
            customAttributes: style="display:none;"
        }
    )

    region metrics (
        name: Metrics
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT '120+' AS METRIC, 'Verified Vendors' as Label from dual
                UNION ALL
                SELECT '4800+' AS METRIC, 'Live Rates' as Label from dual
                UNION ALL
                SELECT '600+' AS METRIC, 'Global Ports' as Label from dual
                ;
                ```
        }
        layout {
            sequence: 20
            parentRegion: @hero-region
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            gridColumns: 3
        }
        card {
            cssClasses: metric-cards
        }
        title {
            column: METRIC
        }
        subtitle {
            column: LABEL
        }
        performance {
            lazyLoading: true
        }
    )

    region parent (
        name: Parent
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @hero-region
            slot: subRegions
            column: 3
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: search-area
        }
        headerAndFooter {
            footerText: <span class='search-footer'>Compare live rates from <b>120+ verified vendors</b> — no booking fees, no sign-up required.</span>
        }
    )

    pageItem P1_CBM (
        type: numberField
        label {
            label: Total CBM
            alignment: left
        }
        layout {
            sequence: 90
            region: @lcl-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: 999G999G999G999G990D00
            width: 30
        }
    )

    pageItem P1_CONTAINER_TYPE (
        type: selectList
        label {
            label: Container Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CONT_TYPE D, pk_id R
                FROM CONTAINER_MST
                order by CONT_TYPE
                
                ```
        }
        layout {
            sequence: 10
            region: @fcl-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    pageItem P1_DESTINATION_PORT (
        type: popupLov
        label {
            label: Destination Port
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            title: Destination Port
        }
        lov {
            type: sharedComponent
            lov: @ports-with-couns
        }
        layout {
            sequence: 50
            region: @parent
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            icon: fa-map-marker
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P1_DIM_UNIT (
        type: selectList
        label {
            label: Dimension Unit
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Meters;1,Feet;3.28084,Inches;39.3701,Centimetres;100
        }
        layout {
            sequence: 10
            region: @lcl-items
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

