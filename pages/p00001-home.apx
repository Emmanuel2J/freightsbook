    )

    pageItem P1_RATE_TYPE (
        type: radioGroup
        label {
            label: &N.
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:<span aria-hidden="true" class="fa fa-truck-container">      Full Container (FCL)</span>;FCL,<span aria-hidden="true" class="fa fa-package">      Less than Container (LCL)</span>;LCL
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @parent
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        default {
            type: static
            staticValue: FCL
        }
        security {
            escapeSpecialChars: false
        }
