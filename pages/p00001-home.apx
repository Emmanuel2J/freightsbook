    process insert-into-search-log (
        name: Insert into Search Log
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P1_RATE_TYPE = 'FCL' THEN
                        INSERT INTO RATE_SEARCH_LOG (
                            SEARCH_TIME,
                            ORIGIN_PORT_ID,
                            DESTINATION_PORT_ID,
                            SEARCH_TYPE,
                            CONT_TYPE,
                            QTY
                        )
                        VALUES (
                            SYSTIMESTAMP,
                            :P1_ORIGIN_PORT,
                            :P1_DESTINATION_PORT,
                            :P1_RATE_TYPE,
                            :P1_CONTAINER_TYPE,
                            REPLACE(:P1_QTY, ',', '')
                        )
                        RETURNING PK_ID INTO :P1_SEARCH_ID;
                
                    ELSE
                        INSERT INTO RATE_SEARCH_LOG (
                            SEARCH_TIME,
                            ORIGIN_PORT_ID,
                            DESTINATION_PORT_ID,
                            SEARCH_TYPE,
                            QTY,
                            DIM_UNIT,
                            WEI_UNIT,
                            ITEM_LENGTH,
                            ITEM_WIDTH,
                            ITEM_HEIGHT,
                            CBM,
                            WEIGHT
                        )
                        VALUES (
                            SYSTIMESTAMP,
                            :P1_ORIGIN_PORT,
                            :P1_DESTINATION_PORT,
                            :P1_RATE_TYPE,
                            REPLACE(:P1_LCL_QTY, ',', ''),
                            :P1_DIM_UNIT,
                            :P1_WEI_UNIT,
                            REPLACE(:P1_LENGTH, ',', ''),
                            REPLACE(:P1_WIDTH, ',', ''),
                            REPLACE(:P1_HEIGHT, ',', ''),
                            REPLACE(:P1_CBM, ',', ''),
                            REPLACE(:P1_TOTAL_WEIGHT, ',', '')
                        )
                        RETURNING PK_ID INTO :P1_SEARCH_ID;
                    END IF;
                
                
                    SEARCH_RATES(:P1_SEARCH_ID);
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15946680265363718
        }
    )

