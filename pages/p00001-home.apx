                    $("#P1_CBM").addClass('apex_disabled');
                    
                    $("#P1_TOTAL_WEIGHT").attr('readonly','readonly');
                    $("#P1_TOTAL_WEIGHT").addClass('apex_disabled');
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SEARCH
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new_2_1 (
        name: New
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @search-1
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
