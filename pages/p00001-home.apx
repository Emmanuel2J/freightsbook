                fireOnInit: false
            }
        )

    )

    validation new (
        name: P1_CONTAINER_TYPE
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P1_CONTAINER_TYPE
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P1_CONTAINER_TYPE
        }
        serverSideCondition {
            whenButtonPressed: @search
        }
    )

    validation p1-dim-unit (
        name: P1_DIM_UNIT
        execution {
            sequence: 90
        }
        validation {
            type: itemIsNotNull
            item: P1_DIM_UNIT
        }
        error {
            errorMessage: #LABEL# must have some value.
            associatedItem: @P1_DIM_UNIT
        }
        serverSideCondition {
            whenButtonPressed: @search-1
        }
    )

