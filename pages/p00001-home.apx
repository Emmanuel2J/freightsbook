            width: 30
        }
    )

    button add (
        buttonName: ADD
        label: Add Containers
        layout {
            sequence: 50
            region: @fcl-items
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            columnCssClasses: u-align-self-center
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-plus-square
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button search (
        buttonName: SEARCH
        label: Search Rates
        layout {
            sequence: 60
            region: @fcl-items
            slot: regionBody
            startNewRow: false
            columnCssClasses: u-align-self-center
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-search
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button search-1 (
        buttonName: SEARCH_1
        label: Search Rates
        layout {
            sequence: 110
            region: @lcl-items
            slot: regionBody
            startNewRow: false
            columnCssClasses: u-align-self-center
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-search
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction calculate-cbm (
        name: Calculate CBM
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: [
                P1_DIM_UNIT
                P1_LENGTH
                P1_HEIGHT
                P1_WIDTH
                P1_LCL_QTY
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CASE WHEN NVL(:P1_DIM_UNIT,0) = 0 THEN 0 ELSE
                     ((REPLACE(NVL(:P1_LENGTH,0),',','') / :P1_DIM_UNIT)
                    *(REPLACE(NVL(:P1_HEIGHT,0),',','') / :P1_DIM_UNIT) 
                    * (REPLACE(NVL(:P1_WIDTH,0),',','') / :P1_DIM_UNIT)) * nvl(:P1_LCL_QTY,0)
                    END AS CBM
                    FROM DUAL
                    ```
                itemsToSubmit: [
                    P1_DIM_UNIT
                    P1_LENGTH
                    P1_WIDTH
                    P1_HEIGHT
                    P1_LCL_QTY
                ]
            }
            affectedElements {
                selectionType: items
                items: P1_CBM
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable (
        name: Disable
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#P1_CBM").attr('readonly','readonly');
                    $("#P1_CBM").addClass('apex_disabled');
                    
                    $("#P1_TOTAL_WEIGHT").addClass('apex_disabled');
                    $("#P1_TOTAL_WEIGHT").attr('readonly','readonly');
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction enable (
        name: Enable
        execution {
            sequence: 30
        }
        when {
            event: apexbeforepagesubmit
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#P1_CBM").removeAttr('readonly');
                    $("#P1_CBM").removeClass('apex_disabled');
                    
                    $("#P1_TOTAL_WEIGHT").removeAttr('readonly');
                    $("#P1_TOTAL_WEIGHT").removeClass('apex_disabled');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P1_RATE_TYPE
        }
        clientSideCondition {
            type: item=value
            item: P1_RATE_TYPE
            value: FCL
        }

        action hide-fcl (
            name: Hide FCL
            action: hide
            affectedElements {
                selectionType: region
                region: @fcl-items
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action hide-lcl (
            name: Hide LCL
            action: hide
            affectedElements {
                selectionType: region
                region: @lcl-items
            }
            execution {
                sequence: 20
            }
        )

        action show-fcl (
            name: Show FCL
            action: show
            affectedElements {
                selectionType: region
                region: @fcl-items
            }
            execution {
                sequence: 10
            }
        )

        action show-lcl (
            name: Show LCL
            action: show
            affectedElements {
                selectionType: region
                region: @lcl-items
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P1_WEIGHT
                P1_WEI_UNIT
                P1_LCL_QTY
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(:P1_WEI_UNIT,0) * REPLACE(NVL(:P1_LCL_QTY,0),' ','') * 
                     REPLACE(NVL(:P1_WEIGHT,0),',','')
                    FROM  DUAL;
                    ```
                itemsToSubmit: [
                    P1_WEI_UNIT
                    P1_LCL_QTY
                    P1_WEIGHT
                ]
            }
            affectedElements {
                selectionType: items
                items: P1_TOTAL_WEIGHT
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_2 (
        name: New
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @search
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
