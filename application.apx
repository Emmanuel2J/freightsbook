app FREIGHTSBRIDGE (
    name: FreightsBridge
    logo {
        type: text
        text: FreightsBridge
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/top-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-tabLike
        ]
        listPosition: top
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: true
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    css {
        fileUrls: #APP_FILES#custom-css#MIN#.css
    }
    authentication {
        scheme: @normal-auth
    }
    sessionStateProtection {
        checksumSalt: E72A29D01C297A22DAE33092F2F31C3378DC94756D9C8AE69914D08B4803564E
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: FreightsBook
        }
    )

)

