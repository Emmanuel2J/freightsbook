)

lov workflow-charts-lov-time-unit (
    name: WORKFLOW_CHARTS.LOV.TIME_UNIT
    source {
        location: staticValues
    }

    entry day (
        sequence: 4
        display: Days
        return: DAY
    )

    entry hour (
        sequence: 3
        display: Hours
        return: HOUR
    )

    entry min (
        sequence: 2
        display: Minutes
        return: MIN
    )

    entry sec (
        sequence: 1
        display: Seconds
        return: SEC
    )

)

