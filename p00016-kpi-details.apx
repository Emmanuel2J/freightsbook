    region rates-2 (
        name: Expiring Rates
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RATE_PK_ID,
                       VENDOR_ID,
                       RATE_REF_NO,
                       RATE_FROM_COUN,
                       FROM_COUN_NAME,
                       RATE_FROM_PORT,
                       FROM_PORT_NAME,
                       FROM_PORT_CODE,
                       RATE_TO_COUN,
                       TO_COUN_NAME,
                       RATE_TO_PORT,
                       TO_PORT_NAME,
                       TO_PORT_CODE,
                       FCL_LCL_FLAG,
                       FCL_CONTAINER_TYPE,
                       CONT_TYPE_NAME,
                       RATE,
                       FCL_RATE,
                       LCL_RATE,
                       TRANSIT_TIME,
                       VALID_FROM,
                       VALID_TO,
                       CUSER,
                       CDATE,
                       UUSER,
                       UDATE
                  from V_RATE_MST
                 where (VENDOR_ID =:A_VENDOR_ID OR :APP_USER = 'ADMIN')
                 and TRUNC(valid_to) BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE) + 2
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: item=value
            item: P16_TAG
            value: 2
        }
        componentAppearance {
            fixedRowHeight: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 44965808897560282
        }

