        column CONT_TYPE_NAME (
            type: textarea
            heading {
                heading: Container Type
            }
            layout {
                sequence: 270
            }
            validation {
                maxLength: 3000
            }
            source {
                databaseColumn: CONT_TYPE_NAME
                dataType: varchar2
            }
            columnFilter {
