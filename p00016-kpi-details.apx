    region rate-views (
        name: Rate Views
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.RATE_PK_ID,
                       V.VENDOR_ID,
                       V.RATE_REF_NO,
                       V.RATE_FROM_COUN,
                       V.FROM_COUN_NAME,
                       V.RATE_FROM_PORT,
                       V.FROM_PORT_NAME,
                       V.FROM_PORT_CODE,
                       V.RATE_TO_COUN,
                       V.TO_COUN_NAME,
                       V.RATE_TO_PORT,
                       V.TO_PORT_NAME,
                       V.TO_PORT_CODE,
                       V.FCL_LCL_FLAG,
                       V.FCL_CONTAINER_TYPE,
                       V.CONT_TYPE_NAME,
                       V.RATE,
                       V.FCL_RATE,
                       V.LCL_RATE,
                       V.TRANSIT_TIME,
                       V.VALID_FROM,
                       V.VALID_TO,
                       V.CUSER,
                       V.CDATE,
                       V.UUSER,
                       V.UDATE
                  from V_RATE_MST V
                  JOIN RATE_SEARCH_RESULTS s ON V.RATE_PK_ID = s.RATE_PK_ID
                 where (V.VENDOR_ID =:A_VENDOR_ID OR :APP_USER = 'ADMIN') 
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: item=value
            item: P16_TAG
            value: 4
        }
        componentAppearance {
            fixedRowHeight: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 61778031091427978
        }

