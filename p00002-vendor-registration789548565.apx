            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noUI
                js-headingLevel-3
                t-Region--scrollBody
                margin-top-md
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: sub-headings
        }
    )

    region company-information (
