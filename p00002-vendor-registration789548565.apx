            location: localDatabase
            tableName: VENDOR_MST
        }
        layout {
            sequence: 40
            parentRegion: @new-vendor-registraion
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--standardPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: add
        }
    )

    region success-message (
        name: Vendor Application Submitted
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class = 'success-sub'>Thank you for applying with FreightsBook!</div>
                <div class = 'success-sub'>We will be getting back to you within 2-3 buisness days, about the status of your application.
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--success
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_PK_ID
        }
    )

