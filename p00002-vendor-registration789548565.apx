page 2 (
    name: Vendor Registration
    alias: VENDOR-REGISTRATION789548565
    title: Vendor Registration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .inc-font{
                font-size: large;
            }
            
            .t-Header{
                display: none;
            }
            
            body{
                background-color: #E3EAFF;
            }
            
            .main-headings > .t-Region-header > .t-Region-headerItems > .t-Region-title{
                font-size: 1.5rem;
            }
            .main-headings .head-sub-heading{
                font-size: 0.8rem;
                color:grey;
            }
            
            .sub-headings  > .t-Region-header > .t-Region-headerItems > .t-Region-title{
                font-size:1.2rem;
            }
            .sub-headings{
                border-bottom: 1px solid rgb(205, 205, 205);
                border-radius: 0;
            }
            
            .success-sub{
                text-align: center;
            
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region business-registration-certificate (
        name: Business Registration Certificate
        title: Business Registration Certificate
        type: staticContent
        layout {
            sequence: 200
            parentRegion: @registration-form
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noUI
                js-headingLevel-3
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: sub-headings
        }
    )

    region company-details (
        name: Company Details
