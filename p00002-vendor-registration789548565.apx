    button submit (
        buttonName: SUBMIT
        label: Submit Application
        layout {
            sequence: 270
            region: @registration-form
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
            requiresConfirmation: true
        }
        confirmation {
            message: If the details entered here are accurate, please click the below to submit.
            style: warning
        }
    )

    process initialize-form-vendor-registration (
        name: Initialize form Vendor Registration
        type: formInitialization
        formRegion: @registration-form
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3901332402550607
        }
    )

    process new (
        name: Start Workflow
        type: workflow
        workflow {
            definition: @vendor-registration
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 9114319332555545
        }

        parameter (
            name: @P_DOC_ID
            value {
                type: staticValue
                staticValue: 1
            }
        )

        parameter (
            name: @P_DOC_REQ_ID
            value {
                item: P2_PK_ID
            }
        )

    )

    process pre-insert (
        name: Pre-Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_REF_ID NUMBER;
                    V_REF_NO VARCHAR2(3000);
                BEGIN
                    SELECT NVL(MAX(TO_NUMBER(REPLACE(VENDOR_REF_NO,'V',''))),0) + 1 --Assuming all vendor ref no. starts with V
                    INTO V_REF_ID
                    FROM VENDOR_MST;
                
                    V_REF_NO := 'V' || V_REF_ID;
                
                    :P2_VENDOR_REF_NO := V_REF_NO; --Set this before form processing
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3904712467550641
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process process-form-registration-form (
        name: Process form Registration Form
        type: formAutoRowProcessing
        formRegion: @registration-form
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &N.
        }
        advanced {
            executionMappingIdentifier: 3904614461550640
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process set-theme-style-for-forms (
        name: Set Theme Style for Forms
        type: executeCode
        source {
            plsqlCode:
                ```plsql
