    button edit (
        buttonName: EDIT
        label: Edit Search
        layout {
            sequence: 20
            region: @summary
            slot: regionBody
            startNewRow: false
            column: 12
            columnCssClasses: u-align-self-center
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
        advanced {
            htmlDomId: edit-btn
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P12_SORT
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p12-dest-c-port (
        itemName: P12_DEST_C_PORT
        execution {
            sequence: 20
            point: afterHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT iNITCAP(PORT_NAME) || ', ' || COUN_NAME AS PORT_NAME
                FROM V_COUN_WITH_PORT WHERE PORT_PK_ID = :P12_DESTINATION_PORT_ID;
                
                ```
        }
    )

    computation p12-dest-port-code (
        itemName: P12_DEST_PORT_CODE
        execution {
            sequence: 40
            point: afterHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT PORT_CODE
                FROM V_COUN_WITH_PORT WHERE PORT_PK_ID = :P12_DESTINATION_PORT_ID;
                
                ```
        }
    )

    computation p12-origin-c-port (
        itemName: P12_ORIGIN_C_PORT
        execution {
            sequence: 10
            point: afterHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT iNITCAP(PORT_NAME) || ', ' || COUN_NAME AS PORT_NAME
                FROM V_COUN_WITH_PORT WHERE PORT_PK_ID = :P12_ORIGIN_PORT_ID;
                
                ```
        }
    )

    computation p12-origin-port-code (
        itemName: P12_ORIGIN_PORT_CODE
