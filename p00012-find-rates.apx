    computation p12-search-dets (
        itemName: P12_SEARCH_DETS
        execution {
            sequence: 50
            point: afterHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_char VARCHAR2(3000);
                BEGIN
                    IF :P12_SEARCH_TYPE = 'FCL' THEN
                        SELECT GET_CONT_NAME(:P12_CONT_TYPE) || ' · Qty ' || 
                               TO_CHAR(:P12_QTY_1, 'FM999G999G990')
                        INTO v_char
                        FROM dual;
                    ELSE
                        SELECT TO_CHAR(:P12_CBM_1, 'FM999G999G990D00') || ' CBM / ' || 
                               TO_CHAR(:P12_WEIGHT_1, 'FM999G999G990D00') || ' kg'
                        INTO v_char
                        FROM dual;
                    END IF;
                
                    RETURN v_char;
                END;
                ```
        }
    )

