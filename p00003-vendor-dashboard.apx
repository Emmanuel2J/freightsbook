page 3 (
    name: Vendor Dashboard
    alias: VENDOR-DASHBOARD
    title: Vendor Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #dash-tabs .t-Tabs-link:focus {
                outline: none;
                outline-offset: none;
            }
            
            
            
            .main-heading .t-HeroRegion-title{
                font-size: 1.6rem !important;
                    line-height: 1.3;
            }
            
            .subtitle{
                font-size: 0.9rem !important;
            
            
            }
            
            #add-rate > span.t-Icon.t-Icon--right.fa.fa-plus-square{
                display: none;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region approvals (
        name: Approvals
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @dash-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            icon: fa-tasks
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER = 'ADMIN'
        }
    )

    region dash-tabs (
        name: Tabs Container
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                t-TabsRegion-mod--fillLabels
                t-Tabs--inlineIcons
                t-TabsRegion-mod--pill
            ]
        }
        advanced {
            htmlDomId: dash-tabs
        }
    )

    region manage-rates (
        name: Manage Rates
        title: Manage Rates
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @dash-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            icon: fa-ship
        }
    )

    region manage-your-rates (
        name: Manage your Rates
        type: staticContent
        source {
            htmlCode: <p class = 'subtitle'>Add, edit, and delete your freight rates directly from this interface</p>
        }
        layout {
            sequence: 10
            parentRegion: @manage-rates
            slot: subRegions
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
                js-headingLevel-5
            ]
            cssClasses: main-heading
        }
    )

    region my-tasks-report (
        name: My Tasks - Report
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       task_type,
                       task_def_name,
                       (select param_value from apex_task_parameters ap_task where 
                       ap_task.task_id = t.task_id
                 and param_static_id = 'P_DOC_REQ_ID') as doc_req_id,
                       details_app_name,
                       details_link_target,
                       subject,
                       initiator,
                       actual_owner,
                       priority,
                       due_on,
                       due_in,
                       due_in_hours,
                       due_code,
                       state_code,
                       is_completed,
                       outcome,
                       created_on,
                       created_ago,
                       created_ago_hours,
                       last_updated_on,
                       badge_text,
                       badge_state
                  from table ( apex_human_task.get_tasks (
                                   p_context            => 'MY_TASKS',
                                   p_show_expired_tasks => :P3_SHOW_EXPIRED
                                   --, p_application_id => :APP_ID
                                   ) ) t
                ```
            pageItemsToSubmit: P3_SHOW_EXPIRED
            optimizerHint: APEX$USE_NO_GROUPING_SETS
        }
        orderBy {
            type: item
            item: {
                itemName: P3_SORT_BY
                orderBys: {
                    CREATED_ON: created_on desc
                    DUE_ON: priority asc, due_on asc nulls last
                }
            }
        }
        layout {
            sequence: 50
            parentRegion: @approvals
            slot: regionBody
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: main
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &SUBJECT.
            description:
                ```html
                <strong>&TASK_DEF_NAME!HTML.</strong>
                {if INITIATOR/}
                    <span role="separator" aria-label="&middot;"> &middot; </span>
                    &{APEX.TASK.INITIATED_BY_USER_SINCE 0=&INITIATOR!HTML. 1=&CREATED_AGO.}.
                {endif/}
                {if !IS_COMPLETED/}
                    {case DUE_CODE/}
                        {when OVERDUE/}
                            <span role="separator" aria-label="&middot;"> &middot; </span>
                            <strong class="u-danger-text">&{APEX.TASK.DUE_SINCE 0=&DUE_IN.}.</strong>
                        {when NEXT_HOUR/}
                            <span role="separator" aria-label="&middot;"> &middot; </span>
                            <strong class="u-danger-text">&{APEX.TASK.DUE_SINCE 0=&DUE_IN.}.</strong>
                        {when NEXT_24_HOURS/}
                            <span role="separator" aria-label="&middot;"> &middot; </span>
                            <span class="u-danger-text">&{APEX.TASK.DUE_SINCE 0=&DUE_IN.}.</span>
                        {otherwise/}
                            {if DUE_IN/}
                                <span role="separator" aria-label="&middot;"> &middot; </span>
                                &{APEX.TASK.DUE_SINCE 0=&DUE_IN.}.
                            {endif/}
                    {endcase/}
                {endif/}
                {if !IS_COMPLETED/}
                    <span role="separator" aria-label="&middot;"> &middot; </span>
                    {case PRIORITY/}
                        {when 1/}
                            <strong class="u-danger-text">&{APEX.TASK.PRIORITY.1.DESCRIPTION}.</strong>
                        {when 2/}
                            <span class="u-danger-text">&{APEX.TASK.PRIORITY.2.DESCRIPTION}.</span>
                        {when 3/}
                            &{APEX.TASK.PRIORITY.3.DESCRIPTION}.
                        {when 4/}
                            &{APEX.TASK.PRIORITY.4.DESCRIPTION}.
                        {when 5/}
                            &{APEX.TASK.PRIORITY.5.DESCRIPTION}.
                    {endcase/}
                {endif/}
                
                ```
            displayBadge: true
        }
        plugin-badge {
            label: State
            value: BADGE_TEXT
            state: BADGE_STATE
        }
        plugin-appearance {
            applyThemeColors: false
        }
        pagination {
            type: scroll
        }
        entityTitle {
            singular: task
            plural: tasks
        }
        messages {
            whenNoDataFound: No Tasks
            noDataFoundIcon: fa-clipboard-check-alt fa-lg
        }

