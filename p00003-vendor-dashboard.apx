            layout {
                sequence: 20
            }
            source {
                databaseColumn: TASK_TYPE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 10
                    items: {
                        P10_PK_ID: &DOC_REQ_ID.
                    }
                }
            }
        )

        action approve (
            position: primaryActions
            template: button
            label: Approve
            layout {
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-check-square u-success-text
                cssClasses: approve
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :TASK_TYPE = 'APPROVAL' and :STATE_CODE != 'INFO_REQUESTED'
            }
        )

        action claim (
            position: primaryActions
            template: button
            label: Claim
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-user-plus u-hot-text
                cssClasses: claim
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :STATE_CODE = 'UNASSIGNED'
            }
        )

        action reject (
            position: primaryActions
            template: button
            label: Reject
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: #
                linkAttributes: data-id="&TASK_ID."
            }
            appearance {
                displayType: textWithIcon
                icon: fa-times u-danger-text
                cssClasses: reject
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :TASK_TYPE = 'APPROVAL' and :STATE_CODE != 'INFO_REQUESTED'
            }
        )

    )

    region new (
