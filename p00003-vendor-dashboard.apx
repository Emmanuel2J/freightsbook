    pageItem P3_REJ_REASON (
        type: textarea
        label {
            label: Reason for Rejection
            alignment: left
        }
        layout {
            sequence: 10
            region: @rejection-reason
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--indicatorAsterisk
            ]
            width: 30
            height: 5
            valuePlaceholder: Please enter a reason for rejection...
        }
        source {
            used: always
        }
    )

    pageItem P3_SHOW_EXPIRED (
        type: checkbox
        label {
            label: Show expired tasks
            alignment: left
        }
        settings {
            useDefaults: false
